---
import '../styles/home.scss';
import '../styles/global.scss';
import '../styles/scroll-slider.scss';
import '../styles/mobile-slider.scss';
import '../styles/scroll-top.scss';
import '../styles/slider.scss';
import '../styles/about-me.scss';
import '../styles/layout.scss';
import '../styles/responsive.scss';
import scrollSvg from '../../public/scroll.svg?raw';
import arrowSvg from '../../public/arrow.inline.svg?raw';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pierre Cayol</title>
    <meta
      property="og:image"
      content="http://portfolio.pcayol.com/images/portfolio2020.png"
    />
    <link rel="icon" href="/favicon-pc.ico" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Open+Sans:200,300,400,500,600,900"
    />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-157149025-1"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'UA-157149025-1');
    </script>
  </head>
  <body>
    <div class="layout home">
      <slot />
      <button type="button" class="scroll-icon is-scrolling" aria-label="Scroll down">
        <Fragment set:html={scrollSvg} />
      </button>
      <button type="button" class="scroll-top" aria-label="Back to top" style="display: none;">
        <Fragment set:html={arrowSvg} />
      </button>
    </div>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
